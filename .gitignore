.ipynb_checkpoints
profile_default/
ipython_config.py

# pdm / pixi / PEP 582
.pdm-python
.pdm-build/
.pixi
__pypackages__/

# SageMath parsed files
*.sage.py

# Environments
.env
.envrc
.venv
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder / Rope / mkdocs
.spyderproject
.spyproject
.ropeproject
/site

