# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
# large local data caches (hp.obo, hp.index, ClinVar, gnomAD, GTF/FASTA)
*.csv
*.parquet
*.gz
*.zip
downloads/
.cache
.cache/
# ...but keep small, hand-written CSVs that ship with the repo
!examples/*.csv
!tests/fixtures/*.csv

# CNV scorer (clone separately; ships a large ClinGen dosage map)
ClassifyCNV/

# agent run ledger (durable audit log — not source)
*.agent_runs.jsonl
agent_runs.jsonl

# stray local conda/micromamba env prefix (created by a cwd-relative install)
/y/

# NEVER commit: judge/truth answer-key material (session-local only)
# (keep any such files outside the repository)

# ---------------------------------------------------------------------------
# Python (adapted from github/gitignore Python.gitignore)
# ---------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*.pyc
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django / Flask / Scrapy / Celery / Sphinx / PyBuilder
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache
.scrapy
docs/_build/
.pybuilder/
target/
celerybeat-schedule
celerybeat.pid

